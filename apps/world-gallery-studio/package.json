{
  "name": "world-gallery-studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "seed:samples:dry-run": "node --env-file=../web/.env.local scripts/seed-samples.mjs",
    "seed:samples": "node --env-file=../web/.env.local scripts/seed-samples.mjs --write",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^6.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.15.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "eslint": "^9.28",
    "patch-package": "^8.0.1",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "js-yaml": "^4.3.2",
    "@vercel/frameworks": {
      "js-yaml": "^4.3.2",
      "smol-toml": "^1.8.0"
    },
    "typeid-js": {
      "uuid": "^11.1.1"
    }
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
}
